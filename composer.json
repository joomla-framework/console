{
    "name": "joomla/console",
    "type": "joomla-package",
    "description": "Joomla Console Package",
    "keywords": ["joomla", "framework", "console"],
    "homepage": "https://github.com/joomla-framework/console",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0",
        "joomla/application": "^4.0",
        "joomla/event": "^4.0",
        "joomla/string": "^4.0",
        "symfony/console": "^v7.0.0",
        "symfony/error-handler": "^7"
    },
    "require-dev": {
        "joomla/test": "^4.0",
        "phpunit/phpunit": "^12.0",
        "psr/container": "^2.0",
        "squizlabs/php_codesniffer": "^3.10.2",
        "phpstan/phpstan": "2.1.17",
        "phpstan/phpstan-deprecation-rules": "2.0.3"
    },
    "suggest": {
        "psr/container-implementation": "To use the ContainerLoader"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Console\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev"
}
